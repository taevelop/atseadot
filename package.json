{
  "name": "atseadot",
  "version": "1.0.0",
  "private": true,
  "description": "At Sea dot PARTY - a pixel-art diving and fishing game",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "check": "node --check site/assets/js/game.js",
    "build": "npm run check && npm test",
    "dev": "wrangler pages dev --ip 127.0.0.1 --port 8788",
    "preview": "npm run dev",
    "deploy": "npm run build && npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy site",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "sharp": "0.35.2",
    "wrangler": "4.130.0"
  }
}
